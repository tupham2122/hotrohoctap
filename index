  const correct=quizPool[quizIdx];
  const others=quizPool.filter(w=>w.id!==correct.id).sort(()=>Math.random()-.5).slice(0,3);
  const opts=[correct,...others].sort(()=>Math.random()-.5);
  const showJP=Math.random()>0.5;
  const imgSrc=IMGS[correct.id]||'';
  const imgHtml=imgSrc?`<div class="mc-img-wrap"><img class="mc-img" src="${imgSrc}"></div>`:'';
  mcAnswered=false;
  el.innerHTML=`<div class="mc-card">
    <div class="mc-qnum">${currentLang==='vn'?'Câu':'問題'} ${quizIdx+1} / ${quizPool.length}</div>
    ${imgHtml}
    <div class="mc-q${showJP?' jp':''}">${showJP?correct.kanji:correct.viet}</div>
    ${showJP?`<div class="mc-sub">${correct.hira} <button class="speak-btn" onclick="speak('${correct.hira}')">🔊</button></div>`:''}
    <div class="mc-opts">
      ${opts.map(o=>`<button class="mc-opt" data-id="${o.id}" data-correct="${correct.id}" onclick="answerMC(this)">
        ${showJP?o.viet:o.kanji}${!showJP?`<br><span style="font-size:11px;font-family:'Noto Sans JP',sans-serif;opacity:.7">${o.hira}</span>`:''}
      </button>`).join('')}
    </div>
    <div id="mcFeedback"></div>
  </div>`;
}

function answerMC(btn){
  if(mcAnswered)return;
  mcAnswered=true;
  const chosen=btn.dataset.id,correctId=btn.dataset.correct;
  const isOk=chosen===correctId;
  const L=LANG[currentLang];
  recordAnswer(isOk,correctId);
  document.querySelectorAll('.mc-opt').forEach(o=>o.classList.add('disabled'));
  btn.classList.add(isOk?'correct':'wrong');
  if(!isOk) document.querySelectorAll('.mc-opt').forEach(o=>{if(o.dataset.id===correctId)o.classList.add('correct');});
  if(isOk)quizCorrect++;else quizWrong++;
  updateQuizStats();
  const fb=document.getElementById('mcFeedback');
  fb.className='mc-fb '+(isOk?'ok':'fail');
  fb.innerHTML=isOk?L.mcCorrect:L.mcWrong;
  fb.insertAdjacentHTML('afterend',`<button class="mc-next" onclick="nextMC()">${L.mcNext}</button>`);
}

function nextMC(){quizIdx++;mcAnswered=false;renderQuiz();}

const MATCH_SIZE=5;
function renderMatch(){
  const el=document.getElementById('quizContent');
  const L=LANG[currentLang];
  if(!quizPool.length||quizIdx>=quizPool.length){showQuizDone(el);return;}
  const batch=quizPool.slice(quizIdx,quizIdx+MATCH_SIZE);
  matchPairs=batch.map(w=>({id:w.id,viet:w.viet,kanji:w.kanji,hira:w.hira}));
  matchLeftSel=null;matchRightSel=null;
  const lefts=[...matchPairs].sort(()=>Math.random()-.5);
  const rights=[...matchPairs].sort(()=>Math.random()-.5);
  el.innerHTML=`<div class="match-wrap">
    <div class="match-title">${L.matchTitle}</div>
    <div class="match-cols">
      <div class="match-col">
        <div class="match-lbl">${L.matchLbl1}</div>
        ${lefts.map(w=>`<div class="match-item" id="ml_${w.id}" onclick="selectMatch('left','${w.id}')">${w.viet}</div>`).join('')}
      </div>
      <div class="match-col">
        <div class="match-lbl">${L.matchLbl2}</div>
        ${rights.map(w=>`<div class="match-item jp" id="mr_${w.id}" onclick="selectMatch('right','${w.id}')">${w.kanji}<br><span style="font-size:11px;opacity:.7">${w.hira}</span></div>`).join('')}
      </div>
    </div>
    <div id="matchFeedback" style="text-align:center;margin-top:10px;font-size:13px;font-weight:600;color:var(--muted)"></div>
    <button class="match-next" id="matchNextBtn" onclick="renderMatch()" style="display:none">${L.matchNext}</button>
  </div>`;
}

function selectMatch(side,id){
  const el=document.getElementById(side==='left'?`ml_${id}`:`mr_${id}`);
  if(el.classList.contains('matched-ok'))return;
  if(side==='left'){
    if(matchLeftSel)document.getElementById(`ml_${matchLeftSel}`)?.classList.remove('selected');
    matchLeftSel=id;el.classList.add('selected');
  }else{
    if(matchRightSel)document.getElementById(`mr_${matchRightSel}`)?.classList.remove('selected');
    matchRightSel=id;el.classList.add('selected');
  }
  if(matchLeftSel&&matchRightSel){
    const lEl=document.getElementById(`ml_${matchLeftSel}`);
    const rEl=document.getElementById(`mr_${matchRightSel}`);
    const L=LANG[currentLang];
    if(matchLeftSel===matchRightSel){
      lEl.classList.remove('selected');lEl.classList.add('matched-ok');lEl.style.pointerEvents='none';
      rEl.classList.remove('selected');rEl.classList.add('matched-ok');
      recordAnswer(true,matchLeftSel);quizCorrect++;updateQuizStats();
      const allDone=matchPairs.every(p=>document.getElementById(`ml_${p.id}`)?.classList.contains('matched-ok'));
      if(allDone){
        quizIdx+=MATCH_SIZE;
        const fb=document.getElementById('matchFeedback');
        fb.innerHTML=L.matchDone;fb.style.color='#27AE60';
        const nb=document.getElementById('matchNextBtn');
        nb.textContent=L.matchNext;nb.style.display='block';
      }
    }else{
      lEl.classList.remove('selected');lEl.classList.add('matched-fail');
      rEl.classList.remove('selected');rEl.classList.add('matched-fail');
      recordAnswer(false,matchLeftSel);quizWrong++;updateQuizStats();
      setTimeout(()=>{lEl.classList.remove('matched-fail');rEl.classList.remove('matched-fail');},700);
    }
    matchLeftSel=null;matchRightSel=null;
  }
}

function showQuizDone(el){
  const pct=Math.round(quizCorrect/((quizCorrect+quizWrong)||1)*100);
  const L=LANG[currentLang];
  el.innerHTML=`<div class="done-wrap"><div class="done-icon">${pct>=80?'🏆':pct>=50?'👍':'📚'}</div><h2>${pct>=80?L.quizDoneXs:pct>=50?L.quizDoneGood:L.quizDoneNeed}</h2><p>${L.quizDoneRight}: <b>${quizCorrect}</b> — ${L.quizDoneWrong}: <b>${quizWrong}</b><br>${L.quizDonePct} <b>${pct}%</b></p><button class="restart-btn" onclick="initQuiz()">${L.quizRestart}</button></div>`;
}

// KHỞI ĐỘNG
setLang(currentLang);
setMode('flash');
</script></body></html>
