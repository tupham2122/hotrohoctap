let favorites = JSON.parse(localStorage.getItem('favs')||'[]');
function getTodayKey(){ return new Date().toISOString().slice(0,10); }
function loadStats(){ return JSON.parse(localStorage.getItem('learnStats')||'{"total":0,"correct":0,"wrong":0,"days":{},"wordErrors":{}}'); }
function saveStats(s){ localStorage.setItem('learnStats',JSON.stringify(s)); }

function recordAnswer(isCorrect, wordId) {
  const s = loadStats();
  s.total++;
  if(isCorrect) s.correct++; else s.wrong++;
  const today = getTodayKey();
  if(!s.days[today]) s.days[today]={correct:0,wrong:0};
  if(isCorrect) s.days[today].correct++; else s.days[today].wrong++;
  if(!isCorrect) s.wordErrors[wordId]=(s.wordErrors[wordId]||0)+1;
  else if(s.wordErrors[wordId]) s.wordErrors[wordId]=Math.max(0,s.wordErrors[wordId]-0.5);
  saveStats(s);
}

function calcStreak(days) {
  let streak=0;
  const today=new Date();
  for(let i=0;i<365;i++){
    const d=new Date(today); d.setDate(d.getDate()-i);
    const key=d.toISOString().slice(0,10);
    if(days[key]&&(days[key].correct+days[key].wrong)>0) streak++;
    else if(i>0) break;
  }
  return streak;
}

function getSmartDeck() {
  const s=loadStats();
  const err=Object.entries(s.wordErrors).filter(([,v])=>v>0).sort((a,b)=>b[1]-a[1])
    .map(([id])=>WORDS.find(w=>w.id==id)).filter(Boolean);
  const seenIds=new Set(Object.keys(s.wordErrors).map(Number));
  const unseen=WORDS.filter(w=>!seenIds.has(w.id)).sort(()=>Math.random()-.5);
  return [...err,...unseen];
}

function renderStats() {
  const s=loadStats(); const L=LANG[currentLang];
  const total=s.correct+s.wrong;
  const pG=total?Math.round(s.correct/total*100):0;
  const pW=total?Math.round(s.wrong/total*100):0;
  document.getElementById('stStreak').textContent=calcStreak(s.days);
  document.getElementById('stTotal').textContent=s.total;
  document.getElementById('stCorrect').textContent=s.correct;
  document.getElementById('stWrong').textContent=s.wrong;
  document.getElementById('stPct').textContent=pG+'%';
  document.getElementById('stPctW').textContent=pW+'%';
  document.getElementById('stBarGood').style.width=pG+'%';
  document.getElementById('stBarBad').style.width=pW+'%';
  const days=[];
  for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().slice(0,10));}
  document.getElementById('stHistory').innerHTML=days.map(day=>{
    const data=s.days[day]||{correct:0,wrong:0};
    const tot=data.correct+data.wrong;
    const lbl=day===getTodayKey()?L.today:day.slice(5).replace('-','/');
    return `<div class="day-row"><span class="day-date">${lbl}</span><div class="day-info">${tot===0?`<span style="color:var(--muted);font-size:12px">${L.noData}</span>`:`<span class="g">✅ ${data.correct}</span><span class="r">❌ ${data.wrong}</span>`}</div></div>`;
  }).join('');
  const sorted=Object.entries(s.wordErrors).filter(([,v])=>v>0).sort((a,b)=>b[1]-a[1]).slice(0,5);
  document.getElementById('stWeakWords').innerHTML=sorted.length?sorted.map(([id,cnt])=>{
    const w=WORDS.find(x=>x.id==id); if(!w) return '';
    return `<div class="day-row"><div><div style="font-size:13px;font-weight:700;color:var(--navy)">${w.viet}</div><div style="font-family:'Noto Sans JP',sans-serif;font-size:12px;color:var(--red)">${w.kanji}</div></div><span style="font-size:12px;font-weight:700;color:var(--red)">${Math.ceil(cnt)} ${L.weakTimes}</span></div>`;
  }).join(''):`<p style="color:var(--muted);font-size:13px;text-align:center;padding:10px 0">${L.noData}</p>`;
}

